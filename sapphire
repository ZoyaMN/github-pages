import java.io.*; 
import java.net.*;  
class clntChat {  
 public static void main (String[] args) {  
  try{  
   Socket s = new Socket("Localhost", 8001);  
   BufferedReader infu = new BufferedReader(new InputStreamReader (System.in));  
   DataOutputStream out = new DataOutputStream(s.getOutputStream());  
   DataInputStream in = new DataInputStream(s.getInputStream());  
   String msg;  
   System.out.println("To stop chatting with server type Stop");  
   System.out.print("Client says: ");  
   while ((msg = infu.readLine()) != null) {  
    out.writeBytes (msg + "\n");  
    if(msg.equals("STOP")) break;  
    System.out.print("Server says: "+ in.readLine() + "\n");  
    System.out.print("Client says: ");  
   }  
   infu.close();  
   in.close();  
   out.close();  
   s.close();  
  } 
  catch (Exception e) {  
   System.out.println(e.toString());  
  } 
 } 
} 

